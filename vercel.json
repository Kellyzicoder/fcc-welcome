{
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://api.qrserver.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.pwnedpasswords.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "host",
          "value": "fcc-welcome.vercel.app"
        }
      ],
      "destination": "https://fcc-attendance.vercel.app/app/:path*",
      "permanent": false
    },
    {
      "source": "/:path((?:app|app-config|app-help|app-send|app-live|demo)(?:/.*)?)",
      "has": [
        {
          "type": "host",
          "value": "fcc-welcome.vercel.app"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path((?!_next/)[^/]+/.+)",
      "has": [
        {
          "type": "host",
          "value": "fcc-welcome.vercel.app"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "fcc-attendance.vercel.app"
        }
      ],
      "destination": "/app/index.html",
      "permanent": false
    },
    {
      "source": "/:path((?!app/|app$|app-config|app-help|app-send|app-live|privacy|demo|first-timer-thanks|_next/|logo\\.png|favicon\\.ico|u1\\.png|app-preview).+)",
      "has": [
        {
          "type": "host",
          "value": "fcc-attendance.vercel.app"
        }
      ],
      "destination": "/app/index.html",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/app/index.html?demo",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/first-timer-thanks",
      "schedule": "0 20 * * *"
    }
  ]
}
