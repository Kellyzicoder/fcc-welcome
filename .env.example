# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.
# Both are PUBLIC values (they end up in the browser). Never put the Supabase secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (never sent to the browser): lets Reports → "Send report now" email the attendance report.
# Use the same values as the Streamlit app's brevo_api_key and report_sender. Leave unset to keep sending switched off.
BREVO_API_KEY=
REPORT_SENDER=

# Server-only: powers Help → Ask the helper (a chat that answers how-to questions). Get a key at console.anthropic.com;
# the Claude API is billed separately from a Claude chat subscription. Leave unset to switch the helper off.
ANTHROPIC_API_KEY=
# Optional: which Claude model answers. Defaults to claude-haiku-5-5 (small and cheap).
ANTHROPIC_MODEL=
